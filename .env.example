NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1
APP_URL=http://localhost:4000
TRUST_PROXY=false

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/money_marathon?schema=public
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=money-marathon
JWT_AUDIENCE=money-marathon-clients

FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=

CORS_ORIGIN=http://localhost:5173,http://localhost:5174
SWAGGER_ROUTE=/docs
SWAGGER_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Xoxoday Plum sandbox. Generate these under Plum Admin -> Settings -> API.
# Leave XOXODAY_ACCESS_TOKEN empty to keep manual voucher fulfillment enabled.
XOXODAY_BASE_URL=https://stagingstores.xoxoday.com/chef/v1/oauth
XOXODAY_ACCESS_TOKEN=
XOXODAY_REFRESH_TOKEN=
XOXODAY_CLIENT_ID=
XOXODAY_CLIENT_SECRET=
# Optional locally; use a private persistent disk in production.
XOXODAY_TOKEN_STATE_FILE=
XOXODAY_CAMPAIGN_ID=
XOXODAY_LINK_EXPIRY_DAYS=90

# Razorpay Standard Checkout (use Test Mode keys until go-live).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_LUDO_PLUS_PLAN_ID=
RAZORPAY_LUDO_PRO_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
# Optional only while rotating webhook secrets.
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=

# Comma-separated WebRTC ICE server URLs. TURN credentials stay server-side
# and are returned only to authenticated Ludo Pro voice participants.
LUDO_STUN_URLS=stun:stun.l.google.com:19302
LUDO_TURN_URLS=
LUDO_TURN_USERNAME=
LUDO_TURN_CREDENTIAL=

CLOUDINARY_URL=
UPLOADS_DIR=uploads
UPLOAD_MAX_BYTES=5242880

ADMIN_EMAIL=puniaprathvi860@gmail.com
ADMIN_NAME=Money Marathon Admin

# Roulette game: no env vars. All roulette tuning (enable/disable, bet limits,
# payouts, free games, probability mode) lives in the admin Settings store under
# the "Roulette" category (keys game.roulette.*) and needs no redeploy.
# Provably-fair server seeds are generated per round with Node's crypto — nothing
# to configure here.
